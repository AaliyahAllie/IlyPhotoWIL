@model LoginViewModel
@{ ViewData["Title"] = "Login"; }
<section class="auth-wrap"><div class="auth-card"><img class="auth-logo" src="~/images/ily-logo.png" alt="ILY Photo"/><p class="eyebrow">WELCOME BACK</p><h1>Login</h1><p>Clients and the administrator use the same login page.</p><form method="post"><label>Email address<input asp-for="Email" type="email" required placeholder="you@example.com"/></label><label>Password<input asp-for="Password" type="password" required placeholder="••••••••"/></label><button class="btn full" type="submit">Login</button></form><p class="tiny">Frontend demo: use <b>admin@ilyphoto.co.za</b> for admin; any other email opens the client portal.</p><hr/><p>New client? <a asp-action="Register">Create an account</a></p></div></section>
