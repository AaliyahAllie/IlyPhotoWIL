@model BookingViewModel
@{ ViewData["Title"] = "Bookings"; }
<section class="dashboard-head"><div><p class="eyebrow">BOOKINGS</p><h1>Request a booking</h1><p>Busy days are visible without showing another client's private event details.</p></div></section>
@if(TempData["BookingMessage"]!=null){<div class="notice">@TempData["BookingMessage"]</div>}
<section class="booking-layout"><div class="panel"><div class="calendar-toolbar"><button onclick="changeMonth(-1)">←</button><h2 id="calendarTitle"></h2><button onclick="changeMonth(1)">→</button></div><div id="calendar" class="calendar"></div><div class="legend"><span><i class="dot available"></i>Available</span><span><i class="dot busy"></i>Photographer busy</span><span><i class="dot mine"></i>Your booking</span><span><i class="dot blocked"></i>Unavailable</span></div></div><div class="panel"><h2>Booking details</h2><form method="post" id="bookingForm"><label>Event type<select asp-for="EventType" id="eventType"><option>Matric Ball</option><option>Wedding</option><option>Corporate Event</option><option>Birthday / Other</option></select></label><label>Date<input asp-for="Date" type="date" id="bookingDate"/></label><div class="two"><label>Start time<input asp-for="StartTime" type="time" id="startTime"/></label><label>End time<input asp-for="EndTime" type="time" id="endTime"/></label></div><label>Number of hours<input asp-for="Hours" type="number" min="1" id="hours"/></label><label>Location<input asp-for="Location"/></label><label>Notes<textarea asp-for="Notes" rows="4" placeholder="Tell us about your event..."></textarea></label><div class="estimate"><span>Estimated package total</span><strong id="priceEstimate">R1 500</strong></div><button class="btn full" type="submit">Submit booking request</button></form></div></section>
@section Scripts{<script>initBookingCalendar(); initPriceCalculator();</script>}
