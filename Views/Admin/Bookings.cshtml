@{ ViewData["Title"] = "Manage Bookings"; }
<section class="dashboard-head"><div><p class="eyebrow">ADMIN CALENDAR</p><h1>Bookings & availability</h1><p>Approve, deny, reschedule or block dates you do not want to operate.</p></div><button class="btn" onclick="document.getElementById('blockDialog').showModal()">Block a date</button></section>
<section class="booking-layout"><div class="panel"><div class="calendar-toolbar"><button onclick="changeMonth(-1)">←</button><h2 id="calendarTitle"></h2><button onclick="changeMonth(1)">→</button></div><div id="calendar" class="calendar admin-calendar"></div><div class="legend"><span><i class="dot available"></i>Available</span><span><i class="dot busy"></i>Booked</span><span><i class="dot blocked"></i>Blocked</span></div></div><div class="panel"><h2>Booking requests</h2><div class="request-card"><span class="status pending">Pending</span><h3>Wedding</h3><p><b>Client:</b> CL-1024 · Lerato M.</p><p><b>Date:</b> 18 Sep 2026 · 12:00–20:00</p><p><b>Location:</b> Stellenbosch</p><div class="actions"><button class="btn">Approve</button><button class="btn outline">Deny</button><button class="text-btn">Reschedule</button></div></div><div class="request-card"><span class="status pending">Pending</span><h3>Birthday</h3><p><b>Client:</b> CL-1027 · Sam K.</p><p><b>Date:</b> 26 Sep 2026 · 18:00–21:00</p><p><b>Location:</b> Cape Town</p><div class="actions"><button class="btn">Approve</button><button class="btn outline">Deny</button></div></div></div></section>
<dialog id="blockDialog"><form method="dialog" class="dialog-card"><h2>Block availability</h2><label>Date<input type="date" required/></label><label>Reason<input placeholder="Personal leave / unavailable"/></label><button class="btn">Save blocked date</button><button class="btn outline">Cancel</button></form></dialog>
@section Scripts{<script>initBookingCalendar(true);</script>}
