@{ ViewData["Title"] = "Invoice Management"; }
<section class="dashboard-head"><div><p class="eyebrow">INVOICE MANAGEMENT</p><h1>Create & send invoices</h1><p>In the finished system each invoice will be linked to a client ID, added to their portal and emailed to them.</p></div><button class="btn" onclick="document.getElementById('invoiceForm').showModal()">New invoice</button></section>
<section class="section compact"><div class="table-wrap"><table><thead><tr><th>Invoice</th><th>Client</th><th>Booking</th><th>Total</th><th>Status</th><th></th></tr></thead><tbody><tr><td>INV-00041</td><td>CL-1001</td><td>Matric Ball</td><td>R1 500</td><td><span class="status unpaid">Unpaid</span></td><td><button class="text-btn">View</button></td></tr><tr><td>INV-00040</td><td>CL-0998</td><td>Corporate Event</td><td>R2 900</td><td><span class="status confirmed">Paid</span></td><td><button class="text-btn">View</button></td></tr></tbody></table></div></section>
<dialog id="invoiceForm"><form method="dialog" class="dialog-card wide"><h2>Create invoice</h2><div class="two"><label>Client ID<input value="CL-1001"/></label><label>Booking<select><option>Matric Ball — 12 Oct 2026</option></select></label></div><div class="two"><label>Issue date<input type="date"/></label><label>Due date<input type="date"/></label></div><label>Service<input value="Matric Ball Photography"/></label><div class="two"><label>Quantity<input type="number" value="1"/></label><label>Price<input value="1500"/></label></div><label>Payment status<select><option>Unpaid</option><option>Partially Paid</option><option>Paid</option><option>Overdue</option></select></label><button class="btn">Generate & send</button><button class="btn outline">Cancel</button></form></dialog>
